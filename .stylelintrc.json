{
  "extends": [
    "stylelint-config-recommended"
  ],
  "rules": {
    "selector-type-no-unknown": [true, {
      "ignoreTypes": ["/^-styled-mixin/"]
    }],
    "font-family-no-missing-generic-family-keyword": null,
    "property-no-unknown":  null
  },
  "overrides": [
    {
      "files": ["**/*.{js,ts,jsx,tsx}"],
      "customSyntax": "@stylelint/postcss-css-in-js"
    }]
}